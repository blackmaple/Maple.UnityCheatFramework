@inherits LayoutComponentBase
<PageTitle>@Core.GameName</PageTitle>
<MApp>

    <MAppBar App Height="36">
        <MAppBarNavIcon Small OnClick="() => LoadGameResourceAsync()">
            <MIcon>mdi-controller</MIcon>
        </MAppBarNavIcon>
        <MToolbarTitle>@Core.GameName</MToolbarTitle>
        <MSpacer></MSpacer>
        <MButton Small Icon OnClick="() => this.Core.ShowVersionInfo()">
            <MIcon Color="orange darken-4">mdi-alpha-i-circle-outline</MIcon>
        </MButton>
    </MAppBar>


    <MMain>
        <CascadingValue Value="@this">
            <MContainer Fluid>
                <MErrorHandler>
                    @Body
                </MErrorHandler>
            </MContainer>
        </CascadingValue>

    </MMain>
    <MFooter>
        @if (Status == EnumGameServiceStatus.OK)
        {
            <MBottomNavigation @bind-Value="@NavTab" Grow Color="teal" App Height="48">


                @if (Core.CurrencyDisabled == false)
                {
                    <MButton Small Value="UIMainTabs.Tab_Currency" Icon IconName="mdi-alpha-c-circle-outline" Text>
                        资产
                    </MButton>
                }
                @if (Core.InventoryDisabled == false)
                {
                    <MButton Small Value="UIMainTabs.Tab_Inventory" Icon IconName="mdi-alpha-i-circle-outline" Text>
                        资源
                    </MButton>
                }

                @if (Core.CharacterDisabled == false)
                {
                    <MButton Small Value="UIMainTabs.Tab_Character" Icon IconName="mdi-alpha-p-circle-outline" Text>
                        角色
                    </MButton>
                }

                @if (Core.MiscDisabled == false)
                {
                    <MButton Small Value="UIMainTabs.Tab_Misc" Icon IconName="mdi-alpha-o-circle-outline" Text>
                        其他
                    </MButton>

                }

                @if (Core.MonsterDisabled == false)
                {
                    <MButton Small Value="UIMainTabs.Tab_Monster" Icon IconName="mdi-alpha-m-circle-outline" Text>
                        成员
                    </MButton>
                }


            </MBottomNavigation>
        }
    </MFooter>
</MApp>


