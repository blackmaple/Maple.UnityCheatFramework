@inherits LayoutComponentBase
<PageTitle>@Core.GameName</PageTitle>
<MApp>

    <MSystemBar App>
        <MAppBarNavIcon OnClick="() => LoadGameResourceAsync()">
            <MIcon>mdi-gamepad-variant-outline</MIcon>
        </MAppBarNavIcon>
        <MAppBarTitle>@Core.GameName</MAppBarTitle>
        <MSpacer></MSpacer>
        <MButton Icon OnClick="() => this.Core.ShowVersionInfo()">
            <MIcon>mdi-microsoft-xbox-controller-battery-unknown</MIcon>
        </MButton>
    </MSystemBar>


    <MMain>
        <CascadingValue Value="@this">
            <MContainer Fluid>
                <MErrorHandler>
                    @Body
                </MErrorHandler>
            </MContainer>
        </CascadingValue>

    </MMain>
    <MFooter Rounded="true">
        @if (Status == EnumGameServiceStatus.OK)
        {
            <MBottomNavigation @bind-Value="@NavTab" Grow Color="teal" App>
                <MButton Value="UIMainTabs.Tab_Currency" Icon IconName="mdi-alpha-c-circle-outline" Text>
                    资产
                </MButton>
                <MButton Value="UIMainTabs.Tab_Inventory" Icon IconName="mdi-alpha-i-circle-outline" Text>
                    资源
                </MButton>
                <MButton Value="UIMainTabs.Tab_Character" Icon IconName="mdi-alpha-p-circle-outline" Text>
                    角色
                </MButton>
                <MButton Value="UIMainTabs.Tab_Misc" Icon IconName="mdi-alpha-o-circle-outline" Text>
                    其他
                </MButton>
                <MButton Value="UIMainTabs.Tab_Monster" Icon IconName="mdi-alpha-m-circle-outline" Text>
                    成员
                </MButton>

            </MBottomNavigation>
        }
    </MFooter>
</MApp>


