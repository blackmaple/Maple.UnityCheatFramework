@inherits UICommonTab

<MCard Tile MaxWidth="1024" Class="mx-auto">
    <MCardTitle>
        <UICommonSearchToolbar @bind-Value="@SearchContent" Search="() => this.OnSearch()" Reload="() => this.OnReload()" />
    </MCardTitle>
    <MCardText>
        <UIDynamicHeight>
            <MVirtualScroll OverscanCount="2" ItemSize="64" Items="Core.ListMonster_Search">
                <ItemContent>
                    <MListItem Dense>
                        <MListItemAvatar Rounded="true" Size="36">
                            <MImage Src="@context.DisplayImage">
                                <PlaceholderContent>
                                    <MIcon>mdi-border-none-variant</MIcon>
                                </PlaceholderContent>
                            </MImage>
                        </MListItemAvatar>


                        <MListItemContent>
                            <MListItemTitle>
                                <span>@context.ToDisplayName()</span>
                                <MChip XSmall Outlined Color="green" OnClick="() => this.OnSearch(context.DisplayCategory)">
                                    @context.DisplayCategory
                                </MChip>
                            </MListItemTitle>
                            <MListItemSubtitle>@context.ToDisplayDesc()</MListItemSubtitle>
                            <MChipGroup ShowArrows="true">
                                @foreach (var att in context.MonsterAttributes.GetItemAttributes(true))
                                {
                                    <MChip Small Outlined>
                                        <span>@att.ToDisplayName():</span>@att.DisplayValue
                                    </MChip>

                                }
                            </MChipGroup>

                        </MListItemContent>
                        <MListItemAction>
                            <MButtonGroup Borderless Dense>
                                <MButton Loading="@context.Loading" Disabled="@context.Loading" Icon OnClick="() => OnSelected(context)">
                                    <MIcon Color="orange darken-4">mdi-smart-card-outline</MIcon>
                                </MButton>
                                <MButton Loading="@context.Loading" Disabled="@context.Loading" Icon OnClick="() => OnAddMonsterMember(context)">
                                    <MIcon Color="orange darken-4">mdi-plus</MIcon>
                                </MButton>
                            </MButtonGroup>
                        </MListItemAction>

                    </MListItem>

                    <MDivider></MDivider>
                </ItemContent>
            </MVirtualScroll>
        </UIDynamicHeight>

    </MCardText>
</MCard>


