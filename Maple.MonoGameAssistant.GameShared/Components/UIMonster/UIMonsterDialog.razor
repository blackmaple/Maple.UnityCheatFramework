@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" Fullscreen>
    <MCard Tile MaxWidth="1024" Class="mx-auto">

        <MCardTitle>
            <UICommonDialogToolbar GameObject="MonsterDisplayDTO" CloseClick="() => this.ClosePopupAsync()" />
        </MCardTitle>
        <MCardText>
            <UICommonChipGroup Column="true" Items="[..MonsterDisplayDTO.MonsterAttributes.GetItemAttributes(false)]" />
        </MCardText>
        <MCardActions>

            <UIDynamicHeight PX="180px">
                <MVirtualScroll OverscanCount="2" ItemSize="64" Items="MonsterDisplayDTO.SkillInfos" Context="item">
                    <ItemContent>
                        <UICommonDisplayItem GameObject="item">
                            <ChipGroupContent>
                                <UICommonChipGroup ShowArrows="true" Items="[..item.SkillAttributes.GetItemAttributes(false)]" />
                            </ChipGroupContent>
                        </UICommonDisplayItem>
                        <MDivider></MDivider>
                    </ItemContent>
                </MVirtualScroll>
            </UIDynamicHeight>


        </MCardActions>

    </MCard>
</MDialog>

