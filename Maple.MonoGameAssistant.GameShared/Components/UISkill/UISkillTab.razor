@inherits UICommonTab

<MCard Tile MaxWidth="1024" Class="mx-auto">
    <MCardTitle>
        <UICommonSearchToolbar @bind-Value="@SearchContent" Search="() => this.OnSearch()" Reload="() => this.OnReload()" />
    </MCardTitle>
    <MCardText>
        <UIDynamicHeight>

            <MVirtualScroll OverscanCount="2" ItemSize="64" Items="Core.ListSkill_Search" Context="item">
                <ItemContent>
                    <UICommonDisplayItem GameObject="item">
                        <ChipGroupContent>
                            <UICommonChipGroup ShowArrows="true" Items="[..item.SkillAttributes.GetItemAttributes(true)]" />
                        </ChipGroupContent>
                        <ItemActionContent>
                            <MButtonGroup Borderless Dense>
                                <MButton Loading="@item.Loading" Disabled="@(!item.CanUse || item.Loading)" Icon OnClick="() => OnUpdate(item)">
                                    <MIcon Color="orange darken-4">mdi-plus</MIcon>
                                </MButton>
                            </MButtonGroup>
                        </ItemActionContent>
                    </UICommonDisplayItem>
                    <MDivider></MDivider>
                </ItemContent>
            </MVirtualScroll>
        </UIDynamicHeight>

    </MCardText>
</MCard>


