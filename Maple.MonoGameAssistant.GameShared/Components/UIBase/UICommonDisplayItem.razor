<MListItem ThreeLine Dense>
    @if (ShowIcon)
    {
        <MListItemAvatar Rounded="true" Size="36">
            <MImage Src="@GameObject.DisplayImage">
                <PlaceholderContent>
                    <MIcon>mdi-border-none-variant</MIcon>
                </PlaceholderContent>
            </MImage>
        </MListItemAvatar>

    }

    <MListItemContent>
        <MListItemTitle>
            <span>@GameObject.ToDisplayName()</span>
            @if(ShowCategory)
            {
                <MChip XSmall Outlined Color="green" OnClick="@OnClickCategory">
                    @GameObject.DisplayCategory
                </MChip>
            }
        </MListItemTitle>
        <MListItemSubtitle>
            @GameObject.ToDisplayDesc()
            @if (ChipGroupContent is not null)
            {
                @ChipGroupContent
            }
        </MListItemSubtitle>


    </MListItemContent>
    @if (ItemActionContent is not null)
    {
        <MListItemAction>
            @ItemActionContent
        </MListItemAction>

    }
</MListItem>
@code
{
    [EditorRequired, NotNull, Parameter]
    public required GameObjectDisplayDTO GameObject { get; set; }

    [Parameter]
    public RenderFragment? ChipGroupContent { get; set; }

    [Parameter]
    public RenderFragment? ItemActionContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClickCategory { set; get; }

    [Parameter]
    public bool ShowIcon { get; set; } = true;
    [Parameter]
    public bool ShowCategory { get; set; } = true;
}