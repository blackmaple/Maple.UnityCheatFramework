<MToolbar Dense Flat>
    <MTextField Label="模糊查询"
    Color="primary"
    Value="@Value"
    ValueChanged="@ValueChanged"
    TValue="string"
    Clearable
    HideDetails="true"
    AppendOuterIcon="mdi-magnify"
    OnAppendOuterClick="@Search"
    OnClearClick="@Search"
    OnEnter="@Search">
    </MTextField>
    <MButton Icon OnClick="@Reload">
        @if (IsReloadButton)
        {
            <MIcon Color="orange darken-4">mdi-refresh</MIcon>
        }
        else
        {
            <MIcon>mdi-close</MIcon>
        }
    </MButton>
  
</MToolbar>
@code {

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { set; get; }

    [Parameter]
    public EventCallback Search { set; get; }

    [Parameter]
    public EventCallback Reload { set; get; }

    [Parameter]
    public bool IsReloadButton { set; get; } = true;
}