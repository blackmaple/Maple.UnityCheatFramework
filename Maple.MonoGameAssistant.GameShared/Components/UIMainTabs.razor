@using Maple.MonoGameAssistant.GameShared.Components.UICharacter
@using Maple.MonoGameAssistant.GameShared.Components.UICurrency
@using Maple.MonoGameAssistant.GameShared.Components.UIInventory
@using Maple.MonoGameAssistant.GameShared.Components.UIMisc
@using Maple.MonoGameAssistant.GameShared.Components.UIMonster
<MTabsItems @bind-Value="@NavTab">
    <MTabItem Value="@Tab_Currency">
        <UICurrencyTab TabKey="@EnumGameUITabKey.Tab_Currency"></UICurrencyTab>
    </MTabItem>
    <MTabItem Value="@Tab_Inventory">
        <UIInventoryTab TabKey="EnumGameUITabKey.Tab_Inventory"></UIInventoryTab>
    </MTabItem>
    <MTabItem Value="@Tab_Character">
        <UICharacterTab TabKey="EnumGameUITabKey.Tab_Character"></UICharacterTab>
    </MTabItem>
    <MTabItem Value="@Tab_Misc">
        <UIMiscTab TabKey="EnumGameUITabKey.Tab_Misc"></UIMiscTab>
    </MTabItem>
    <MTabItem Value="@Tab_Monster">
        <UIMonsterTab TabKey="EnumGameUITabKey.Tab_Monster"></UIMonsterTab>
    </MTabItem>
    <MTabItem Value="@Tab_Forge">
        <UICharacterTab TabKey="EnumGameUITabKey.Tab_Forge"></UICharacterTab>
    </MTabItem>
</MTabsItems>
