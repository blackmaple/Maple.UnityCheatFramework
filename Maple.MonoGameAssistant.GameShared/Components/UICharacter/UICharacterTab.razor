@inherits UICommonTab

<MCard Tile MaxWidth="1024" Class="mx-auto">
    <MCardTitle>
        <UICommonSearchToolbar @bind-Value="@SearchContent" Search="() => this.OnSearch()" Reload="() => this.OnReload()" />
    </MCardTitle>
    <MCardText>
        <UIDynamicHeight>
            <MVirtualScroll OverscanCount="2" ItemSize="64" Items="Core.ListCharacter_Search" Context="item">
                <ItemContent>
                    <UICommonDisplayItem GameObject="item" OnClickCategory="() => this.OnSearch(item.DisplayCategory)">
                        <ChipGroupContent>
                            <UICommonChipGroup ShowArrows="true" Items="[..item.CharacterAttributes.GetItemAttributes(true)]" />
                        </ChipGroupContent>
                        <ItemActionContent>
                            <MButtonGroup Borderless Dense>
                                <MButton Icon Loading="@item.Loading" Disabled="@item.Loading" OnClick="() => OnSelectedCharacterStatus(item)">
                                    <MIcon Color="orange darken-4">mdi-file-edit-outline</MIcon>
                                </MButton>
                                <MButton Icon Loading="@item.Loading" Disabled="@item.Loading" OnClick="() => OnSelectedCharacterSkill(item)">
                                    <MIcon Color="orange darken-4">mdi-magic-staff</MIcon>
                                </MButton>
                            </MButtonGroup>
                        </ItemActionContent>
                    </UICommonDisplayItem>

                    <MDivider></MDivider>
                </ItemContent>
            </MVirtualScroll>
        </UIDynamicHeight>

    </MCardText>
</MCard>


