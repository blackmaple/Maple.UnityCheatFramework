@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" Fullscreen>
    <MCard Tile MaxWidth="1024" Class="mx-auto">
        <MCardTitle>
            <UICommonDialogToolbar GameObject="CharacterDisplay" CloseClick="() => this.ClosePopupAsync()" />
        </MCardTitle>
        <MCardText>
            <UIDynamicHeight PX="120px">
                <MVirtualScroll OverscanCount="2" ItemSize="64" Items="CharacterAttributes" Context="item">
                    <ItemContent>
                        <UICommonDisplayItem GameObject="item" ShowIcon="false">
                            <ItemActionContent>
                                <UICommonAction Item="item" OnClick="() => OnUpdateCharacterStatus(item)" OnChange="() => OnUpdateCharacterStatus(item)" OnMultiple="(i) => OnUpdateCharacterStatus(item, i, true)" />
                            </ItemActionContent>
                        </UICommonDisplayItem>

                        <MDivider></MDivider>
                    </ItemContent>
                </MVirtualScroll>
            </UIDynamicHeight>
        </MCardText>
    </MCard>
</MDialog>

