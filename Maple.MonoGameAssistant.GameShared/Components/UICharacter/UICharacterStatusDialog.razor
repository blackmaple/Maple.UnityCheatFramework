@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" Fullscreen>
    <MCard Tile MaxWidth="1024" Class="mx-auto">
        <MToolbar>
            <UICommonDisplayObject GameObject="@CharacterDisplay" />
            <MSpacer></MSpacer>
            <MButton Icon OnClick="() => this.ClosePopupAsync()">
                <MIcon>mdi-close</MIcon>
            </MButton>
        </MToolbar>

        <MCardSubtitle>@CharacterDisplay.ToDisplayDesc()</MCardSubtitle>
        <MCardText>
            <UIDynamicHeight PX="180px">
                <MVirtualScroll OverscanCount="2" ItemSize="64" Items="CharacterAttributes" Context="item">
                    <ItemContent>
                        <MListItem  Dense Slim @key=item>
                            <MListItemContent>
                                <MListItemTitle>
                                    @item.ToDisplayName()
                                     <MChip XSmall Outlined Color="green"  >
                                        @item.DisplayCategory
                                    </MChip> 
                                </MListItemTitle>
                                <MListItemSubtitle>
                                    @item.ToDisplayDesc()
                                </MListItemSubtitle>
                            </MListItemContent>

                            <MListItemAction>
                                @if (item.MultipleType)
                                {
                                    <MItemGroup Multiple>
                                            @foreach (var i in item.SelectedContents.GetItemAttributes(false))
                                            {
                                                <MItem>
                                                    <MChip ActiveClass="purple--text"
                                                           IsActive="@item.MultipleIsActive(i)"
                                                           OnClick="() => OnUpdateCharacterStatus(item, i, true)"
                                                           Outlined Small>
                                                        @i.ToDisplayName()
                                                    </MChip>
                                                </MItem>

                                            }
                                        </MItemGroup>
                                }
                                else if (item.ButtonType)
                                    {
                                    <MButton Icon
                                             Color="orange darken-4"
                                             Loading="@item.Loading"
                                             Disabled="item.Loading"
                                             OnClick="() => OnUpdateCharacterStatus(item)">
                                        <MIcon>mdi-crosshairs</MIcon>
                                    </MButton>
                                    }
                                else if (item.SelectsType)
                                    {
                                    <MSelect Solo Dense HideDetails="true"
                                             TItem="GameValueInfoDTO"
                                             TItemValue="string"
                                             TValue="string"
                                             @bind-Value="@item.ContentValue"
                                             Items="item.SelectedContents"
                                             ItemText="p => p.DisplayName"
                                             ItemValue="p => p.DisplayValue"
                                             Color="orange darken-4"
                                             OnChange="()=>OnUpdateCharacterStatus(item)"
                                             SingleLine></MSelect>

                                    }
                                else if (item.SwitchesType)
                                    {
                                    <MSwitch Inset Dense HideDetails="true"
                                             Color="orange darken-4"
                                             Loading="@item.Loading"
                                             Disabled="item.Loading"
                                             OnClick="() => OnUpdateCharacterStatus(item)"
                                             @bind-Value="@item.SwitchValue">
                                    </MSwitch>
                                    }
                                else if (item.TextEditorType)
                                    {
                                <MTextField Solo OnAppendOuterClick="()=>OnUpdateCharacterStatus(item)"
                                            AppendOuterIcon="mdi-pencil-outline"
                                            Type="number"
                                            TValue="decimal"
                                            Loading="item.Loading"
                                            Disabled="item.Loading"
                                            Dense
                                            HideDetails="true"
                                            @bind-Value="@item.DecimalValue"
                                            NumberProps="@(prop => { prop.Min = int.MinValue; prop.Max = int.MaxValue; prop.Step = 1; prop.HideControl = true; })" />

                                    }
                                else
                                    {
                                    <MLabel>@item.ContentValue</MLabel>
                                    }
                            </MListItemAction>
                        </MListItem>

                        <MDivider></MDivider>
                    </ItemContent>
                </MVirtualScroll>
            </UIDynamicHeight>
        </MCardText>
    </MCard>
</MDialog>

