@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" Fullscreen>
    <MCard Tile MaxWidth="1024" Class="mx-auto">
        <MToolbar>
            <UICommonDisplayObject GameObject="@CharacterDisplay"/>
            <MSpacer></MSpacer>
            <MButton Icon OnClick="() => this.ClosePopupAsync()">
                <MIcon>mdi-close</MIcon>
            </MButton>
        </MToolbar>

        <MCardText>
            <UIDynamicHeight PX="180px">
                <MVirtualScroll OverscanCount="2" ItemSize="64" Items="SkillInfos" Context="item">
                    <ItemContent>
                        <MListItem Dense @key=item>

                            <MListItemAvatar Rounded="true" Size="36">
                                <MImage Src="@item.DisplayImage">
                                    <PlaceholderContent>
                                        <MIcon>mdi-border-none-variant</MIcon>
                                    </PlaceholderContent>
                                </MImage>
                            </MListItemAvatar>


                            <MListItemContent>
                                <MListItemTitle>
                                    <span>@item.ToDisplayName()</span>
                                    <MChip XSmall Outlined Color="green">
                                        @item.DisplayCategory
                                    </MChip>

                                </MListItemTitle>
                                <MListItemSubtitle>@item.ToDisplayDesc()</MListItemSubtitle>
                                <MChipGroup ShowArrows="true">
                                    @{
                                        var datas = item.SkillAttributes.GetItemAttributes(true).ToArray();
                                        if (datas.Any())
                                        {

                                            @foreach (var item in datas)
                                            {
                                                <MChip Small Outlined>
                                                    <span>@item.DisplayName:</span>@item.DisplayValue
                                                </MChip>
                                            }

                                        }
                                    }
                                </MChipGroup>
                            </MListItemContent>
                            <MListItemAction>
                                <MButtonGroup Borderless Dense>
                                    <MButton Icon OnClick="() => OnUpdateCharacterSkill(item, false)" Loading="@item.Loading" Disabled="@(!item.CanWrite)">
                                        <MIcon Color="orange darken-4">mdi-plus</MIcon>
                                    </MButton>
                                    <MButton Icon OnClick="() => OnUpdateCharacterSkill(item, true)" Loading="@item.Loading" Disabled="@(!item.CanWrite)">
                                        <MIcon Color="orange darken-4">mdi-trash-can-outline</MIcon>
                                    </MButton>

                                </MButtonGroup>
                            </MListItemAction>



                        </MListItem>
                        <MDivider></MDivider>
                    </ItemContent>
                </MVirtualScroll>
            </UIDynamicHeight>

        </MCardText>

    </MCard>
</MDialog>

