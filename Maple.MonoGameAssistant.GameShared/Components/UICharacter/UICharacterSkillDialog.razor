@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" Fullscreen>
    <MCard Tile>
        <MToolbar>

            <MListItem>
                <MListItemAvatar Rounded="true" Size="36">
                    <MImage Src="@CharacterDisplay.DisplayImage">
                        <PlaceholderContent>
                            <MIcon>mdi-border-none-variant</MIcon>
                        </PlaceholderContent>
                    </MImage>
                </MListItemAvatar>
                <MListItemContent>

                    <MListItemTitle>
                        <span>@CharacterDisplay.ToDisplayName()</span>
                        <MChip XSmall Outlined Color="green">
                            @CharacterDisplay.DisplayCategory
                        </MChip>

                    </MListItemTitle>
                </MListItemContent>
            </MListItem>

            <MSpacer></MSpacer>
            <MToolbarItems>
                <MButtonGroup Rounded Group>
                    <MButton Icon
                             OnClick="() => this.ClosePopupAsync()">
                        <MIcon>mdi-close</MIcon>
                    </MButton>
                </MButtonGroup>

            </MToolbarItems>
        </MToolbar>

        <MCardSubtitle>@CharacterDisplay.ToDisplayDesc()</MCardSubtitle>
        <MCardText>
            <UIDynamicHeight PX="180px">
                <MVirtualScroll OverscanCount="2" ItemSize="64" Items="SkillInfos" Context="item">
                    <ItemContent>
                        <MListItem Dense Slim @key=item>

                            <MListItemAvatar Rounded="true" Size="36">
                                <MImage Src="@item.DisplayImage">
                                    <PlaceholderContent>
                                        <MIcon>mdi-border-none-variant</MIcon>
                                    </PlaceholderContent>
                                </MImage>
                            </MListItemAvatar>


                            <MListItemContent>
                                <MListItemTitle>
                                    <span>@item.ToDisplayName()</span>
                                    <MChip XSmall Outlined Color="green">
                                        @item.DisplayCategory
                                    </MChip>

                                </MListItemTitle>
                                <MListItemSubtitle>@item.ToDisplayDesc()</MListItemSubtitle>
                                <MChipGroup ShowArrows="true">
                                    @{
                                        var datas = item.SkillAttributes.GetItemAttributes(true).ToArray();
                                        if (datas.Any())
                                        {

                                            @foreach (var item in datas)
                                            {
                                                <MChip Small Outlined>
                                                    <span>@item.DisplayName:</span>@item.DisplayValue
                                                </MChip>
                                            }

                                        }
                                    }
                                </MChipGroup>
                            </MListItemContent>
                            <MListItemAction>
                                <MButtonGroup Rounded>
                                    <MButton Small OnClick="() => OnUpdateCharacterSkill(item, false)" Loading="@item.Loading" Disabled="@(!item.CanWrite)">
                                        <MIcon Color="orange darken-4">mdi-plus</MIcon>
                                    </MButton>
                                    <MButton Small OnClick="() => OnUpdateCharacterSkill(item, true)" Loading="@item.Loading" Disabled="@(!item.CanWrite)">
                                        <MIcon Color="orange darken-4">mdi-trash-can-outline</MIcon>
                                    </MButton>

                                </MButtonGroup>
                            </MListItemAction>



                        </MListItem>
                        <MDivider></MDivider>
                    </ItemContent>
                </MVirtualScroll>
            </UIDynamicHeight>

        </MCardText>

    </MCard>
</MDialog>

