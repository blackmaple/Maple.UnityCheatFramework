@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" Fullscreen>
    <MCard Tile MaxWidth="1024" Class="mx-auto">
        <MCardTitle>
            <UICommonSearchToolbar @bind-Value="@SearchContent" Search="() => this.OnSearch()" IsReloadButton="false" Reload="() => this.ClosePopupAsync(false)" />
        </MCardTitle>

        <MCardText>
            <UIDynamicHeight PX="100px">
                <MVirtualScroll OverscanCount="2" ItemSize="64" Items="ListItem_Search" Context="item">
                    <ItemContent>

                        <UICommonDisplayItem GameObject="item" OnClickCategory="() => this.OnSearch(item.DisplayCategory)">
                            <ChipGroupContent>
                                <UICommonChipGroup ShowArrows="true" Items="[..item.ItemAttributes.GetItemAttributes(true)]" />
                            </ChipGroupContent>
                            <ItemActionContent>
                                <MButtonGroup Borderless Dense>
                                    <MButton Icon OnClick="() => this.OnSelectedData(item)">
                                        <MIcon Color="orange darken-4">mdi-plus</MIcon>
                                    </MButton>
                                </MButtonGroup>
                            </ItemActionContent>
                        </UICommonDisplayItem>
                        <MDivider></MDivider>
                    </ItemContent>
                </MVirtualScroll>
            </UIDynamicHeight>

        </MCardText>
    </MCard>

</MDialog>
