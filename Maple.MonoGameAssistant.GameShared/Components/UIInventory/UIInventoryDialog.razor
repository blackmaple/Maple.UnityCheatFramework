@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" MaxWidth="360" OnOutsideClick="() => this.ClosePopupAsync()">
    <MCard Tile MaxWidth="1024" Class="mx-auto">

        <UICommonDisplayObject GameObject="InventoryDisplay"></UICommonDisplayObject>

        <MCardText>
            <MChipGroup Column>
                @foreach (var item in InventoryDisplay.ItemAttributes.GetItemAttributes(false))
                {
                    <MChip Small Outlined>
                        <span>@item.ToDisplayName():</span>@item.DisplayValue
                    </MChip>
                }
            </MChipGroup>
        </MCardText>
        <MCardActions>
            <MTextField AppendOuterIcon="mdi-pencil-outline"
                        OnAppendOuterClick="@OnUpdateInventoryInfo"
                        Type="number"
                        TValue="int"
                        Loading="Loading"
                        Disabled="Loading"
                        Label="@InventoryDisplay.DisplayName"
                        @bind-Value="InventoryInfo.InventoryCount"
                        NumberProps="@(prop => { prop.Min = int.MinValue; prop.Max = int.MaxValue; prop.Step = 1; prop.HideControl = true; })" />
        </MCardActions>
    </MCard>
</MDialog>

