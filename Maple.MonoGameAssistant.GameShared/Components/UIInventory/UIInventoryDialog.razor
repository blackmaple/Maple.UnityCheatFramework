@inherits Masa.Blazor.Popup.Components.PopupComponentBase

<MDialog Value="Visible" MaxWidth="360" OnOutsideClick="() => this.ClosePopupAsync()">
    <MCard Outlined>
        <MListItem Dense>
            <MListItemAvatar Rounded="true" Size="36">
                <MImage Src="@InventoryDisplay.DisplayImage">
                    <PlaceholderContent>
                        <MIcon>mdi-border-none-variant</MIcon>
                    </PlaceholderContent>
                </MImage>
            </MListItemAvatar>
            <MListItemContent>
                <MListItemTitle>
                    <span>@InventoryDisplay.ToDisplayName()</span>
                    <MChip XSmall Outlined Color="green">
                        @InventoryDisplay.DisplayCategory
                    </MChip>
                </MListItemTitle>
              
            </MListItemContent>
        </MListItem>

        <MCardSubtitle>@InventoryDisplay.ToDisplayDesc()</MCardSubtitle>
        <MCardText>
            <MChipGroup Column>
                @foreach (var item in InventoryDisplay.ItemAttributes.GetItemAttributes(false))
                {
                    <MChip Outlined>
                        <span>@item.ToDisplayName():</span>@item.DisplayValue
                    </MChip>
                }
            </MChipGroup>
        </MCardText>
        <MCardActions>
            <MTextField AppendOuterIcon="mdi-pencil-outline"
                        OnAppendOuterClick="@OnUpdateInventoryInfo"
                        Type="number"
                        TValue="int"
                        Loading="Loading"
                        Disabled="Loading"
                        Label="@InventoryDisplay.DisplayName"
                        @bind-Value="InventoryInfo.InventoryCount"
                        NumberProps="@(prop => { prop.Min = int.MinValue; prop.Max = int.MaxValue; prop.Step = 1; prop.HideControl = true; })" />
        </MCardActions>
    </MCard>
</MDialog>

