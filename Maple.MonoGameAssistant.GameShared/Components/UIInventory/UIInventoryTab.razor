@inherits UICommonTab

<MCard Tile MaxWidth="1024" Class="mx-auto">

    <MCardTitle>
        <UICommonSearchToolbar @bind-Value="@SearchContent" Search="() => this.OnSearch()" Reload="() => this.OnReload()" />
    </MCardTitle>
    <MCardText>
        <UIDynamicHeight>
            <MVirtualScroll OverscanCount="2" ItemSize="64" Items="Core.ListInventory_Search" Context="item">
                <ItemContent>
                    <UICommonDisplayItem GameObject="item">
                        <ChipGroupContent>
                            <UICommonChipGroup ShowArrows="true" Items="[..item.ItemAttributes.GetItemAttributes(true)]" />
                        </ChipGroupContent>
                        <ItemActionContent>
                            <MButtonGroup Borderless Dense>
                                <MButton Loading="@item.Loading" Disabled="@item.Loading" Icon OnClick="() => OnSelected(item)">
                                    <MIcon Color="orange darken-4">mdi-file-edit-outline</MIcon>
                                </MButton>
                            </MButtonGroup>
                        </ItemActionContent>
                    </UICommonDisplayItem>
                    <MDivider></MDivider>
                </ItemContent>
            </MVirtualScroll>
        </UIDynamicHeight>
    </MCardText>
</MCard>


