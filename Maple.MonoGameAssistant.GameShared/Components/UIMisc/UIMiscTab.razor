@inherits UICommonTab

<MCard Tile MaxWidth="1024" Class="mx-auto">

    <MCardTitle>
        <UICommonSearchToolbar 
            @bind-Value="@SearchContent" 
            Search="() => this.OnSearch()" 
            Reload="() => this.OnReload()" />
    </MCardTitle>
    <MCardText>
        <UIDynamicHeight>
            <MVirtualScroll OverscanCount="2" ItemSize="64" Items="Core.ListSwitch_Search" Context="item">
                <ItemContent>
                    <UICommonDisplayItem GameObject="item" OnClickCategory="() => this.OnSearch(item.DisplayCategory)">
                        <ItemActionContent>
                            <UICommonAction Item="item" 
                                OnClick="() => OnChange(item)" 
                                OnChange="() => OnChange(item)" 
                                OnMultiple="(i) => OnChange(item, i, true)" />
                        </ItemActionContent>
                    </UICommonDisplayItem>
                    <MDivider></MDivider>
                </ItemContent>
            </MVirtualScroll>
        </UIDynamicHeight>

    </MCardText>
</MCard>


