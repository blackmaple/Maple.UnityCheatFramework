<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0-windows</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Title>Maple.MonoGameAssistant.DllProxyImp</Title>
	  <RepositoryUrl>https://github.com/blackmaple/Maple.MonoGameAssistant</RepositoryUrl>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
	  <Description>enable interoperability between C# AOT and unity game.</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageTags>unity;mono;il2cpp;c#;dotnet;AOT</PackageTags>
	  <Version>0.26.0401.04-rc</Version>
  </PropertyGroup>

  <ItemGroup>
     <None Include="build\*.targets" Pack="true" PackagePath="buildTransitive\" />
	  <None Include="build\runtimes\win-x64\*.lib" Pack="true" PackagePath="build\runtimes\win-x64\" />
	  <None Include="build\runtimes\win-x86\*.lib" Pack="true" PackagePath="build\runtimes\win-x86\" />
  </ItemGroup>
	<ItemGroup>
		<None Include="..\LICENSE" Link="LICENSE">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
		<None Include="..\README.md" Link="README.md">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>
</Project>
